# Austin Bousquet
# excludes the token information from the container
.env

# excludes the repository information from the container
.git

# excludes the python cache data from the container (python will use on the fly)
__pycache__/
*.py[cod]

# excludes the virtual environment data from the container (python/docker will install dependencies from the requirments.txt file)
.venv/
venv/